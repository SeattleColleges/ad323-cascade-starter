# Copy this file to .env and fill in the values. .env is gitignored: never commit it.
# Only the variable NAMES belong in git; the values stay on your machine.

# Week 9: salt for hashing rider emails in gold.dim_rider.
# Make your own random value with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
# Anyone who knows the salt can test guesses against the hashes, so keep it secret,
# and don't change it later: a new salt gives every rider a different hash.
CASCADE_PII_SALT=
